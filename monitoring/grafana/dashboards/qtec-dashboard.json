          "refId": "A"
        },
        {
          "expr": "rate(http_requests_total{instance='api-2'}[1m])",
          "legendFormat": "api-2 - {{method}} {{route}}",
          "refId": "B"
        },
        {
          "expr": "rate(http_requests_total{instance='api-3'}[1m])",
          "legendFormat": "api-3 - {{method}} {{route}}",
          "refId": "C"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
